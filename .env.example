HIREARCHY_DB_PATH=.data/hirearchy.sqlite
HIREARCHY_EVALUATOR_KEY=replace-with-a-long-local-review-key
# Authenticated internal staging only; use the distinct constrained candidate database role.
STAGING_CANDIDATE_DATABASE_URL=postgres://app_candidate_gateway:replace-with-local-candidate-role-password@127.0.0.1:5432/postgres
# Required for candidate invitations: canonical base64 for exactly 32 random bytes.
# Keep the same key while encrypted candidate invitations remain in the database.
HIREARCHY_CANDIDATE_TOKEN_ENCRYPTION_KEY=replace-with-canonical-base64-32-byte-key
# Optional, credential-gated synthetic experiments only. Candidate Work does not use these.
# Never send candidate or personal data without a separate privacy/provider review.
NVIDIA_API_KEY=replace-with-an-nvidia-api-key
OPENROUTER_KEY=replace-with-an-openrouter-api-key
