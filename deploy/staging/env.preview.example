# Minimal public-preview configuration; this profile has no PostgreSQL, GoTrue or staging secrets.
# Keep CADDY_BIND_ADDRESS at 127.0.0.1 for rehearsal. Public activation requires founder approval.
HIREARCHY_DEPLOY_MODE=public-preview
COMPOSE_PROJECT_NAME=hirearchy-single-team
HIREARCHY_RELEASE_SHA=SET_TO_CHECKED_OUT_40_CHARACTER_COMMIT
HIREARCHY_TRUSTED_PROXY_HOPS=0
PREVIEW_HOSTNAME=preview.example.com
PREVIEW_APP_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_BIND_ADDRESS=127.0.0.1
