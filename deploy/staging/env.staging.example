# Copy to a root-owned file outside the repository and set mode 0600.
# Replace every SET_... value. Generate password values as 64 lowercase hex characters.
HIREARCHY_RELEASE_SHA=SET_TO_CHECKED_OUT_40_CHARACTER_COMMIT
HIREARCHY_TRUSTED_PROXY_HOPS=0

# Public DNS A/AAAA records must point to this Linux host before enabling Caddy.
PREVIEW_HOSTNAME=preview.example.com
STAGING_HOSTNAME=alpha.example.com
# Use only the authorized team's fixed office/VPN egress CIDRs; never 0.0.0.0/0 or ::/0.
STAGING_ALLOWED_CIDRS=SET_TEAM_VPN_EGRESS_CIDRS

# Host-network recipe. All listeners except Caddy remain on IPv4 loopback.
PG_BIND_ADDRESS=127.0.0.1
PG_PORT=5432
AUTH_BIND_ADDRESS=127.0.0.1
GOTRUE_API_PORT=9998
APP_PORT=3000
PREVIEW_APP_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Use `openssl rand -hex 32` for each password and JWT secret.
POSTGRES_PASSWORD=SET_64_HEX_CHARACTERS
GOTRUE_DB_PASSWORD=SET_64_HEX_CHARACTERS
MIGRATOR_DATABASE_PASSWORD=SET_64_HEX_CHARACTERS
R23_GATEWAY_PASSWORD=SET_64_HEX_CHARACTERS
CANDIDATE_GATEWAY_PASSWORD=SET_64_HEX_CHARACTERS
APP_EVALUATOR_PASSWORD=SET_64_HEX_CHARACTERS
CONTROL_WORKER_PASSWORD=SET_64_HEX_CHARACTERS
GOTRUE_JWT_SECRET=SET_64_HEX_CHARACTERS

# Node.js Ed25519 PKCS#8 DER, encoded as base64.
# Generate with the command in deploy/staging/README.md; never commit its output.
STAGING_PROOF_PRIVATE_KEY=SET_BASE64_ED25519_PKCS8_DER
STAGING_PROOF_ISSUER=hirearchy-staging
STAGING_PROOF_AUDIENCE=hirearchy-postgres
STAGING_PROOF_KEY_ID=staging-key-1
HIREARCHY_CANDIDATE_TOKEN_ENCRYPTION_KEY=SET_BASE64_32_BYTE_AES_KEY

# Host-side deployment runner URLs. Never pass STAGING_ADMIN_DATABASE_URL into the app container.
STAGING_ADMIN_DATABASE_URL=postgres://postgres:SET_POSTGRES_PASSWORD@127.0.0.1:5432/postgres
STAGING_MIGRATOR_DATABASE_URL=postgres://hirearchy_migrator:SET_MIGRATOR_PASSWORD@127.0.0.1:5432/postgres
STAGING_DATABASE_URL=postgres://r23_gateway:SET_GATEWAY_PASSWORD@127.0.0.1:5432/postgres
STAGING_CANDIDATE_DATABASE_URL=postgres://app_candidate_gateway:SET_CANDIDATE_GATEWAY_PASSWORD@127.0.0.1:5432/postgres
STAGING_AUTH_URL=http://127.0.0.1:9998
STAGING_AUTH_ISSUER=https://alpha.example.com
STAGING_AUTH_AUDIENCE=authenticated
