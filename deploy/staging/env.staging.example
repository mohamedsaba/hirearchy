# Single-Team Staging Deployment Environment Configuration Example
# Copy to .env.staging and replace placeholder secrets with secure random values.

NODE_ENV=production
HIREARCHY_RUNTIME_PROFILE=staging-authenticated

# Application Host & Port
PORT=3000
HOSTNAME=127.0.0.1

# Database Configuration (PostgreSQL 16+)
# Gateway pool used by web application:
STAGING_DATABASE_URL=postgres://r23_gateway:replace-with-gateway-password@127.0.0.1:5432/staging_db
# Migrator pool used exclusively for applying migrations 0001-0017:
STAGING_MIGRATOR_DATABASE_URL=postgres://hirearchy_migrator:replace-with-migrator-password@127.0.0.1:5432/staging_db

# GoTrue Authentication Configuration
STAGING_AUTH_URL=http://127.0.0.1:9998
STAGING_AUTH_ISSUER=https://auth.staging.hirearchy.local
STAGING_AUTH_AUDIENCE=authenticated
GOTRUE_JWT_SECRET=replace-with-minimum-32-character-secret-key-12345

# Ed25519 Asymmetric Staging Proof Keys
STAGING_PROOF_ISSUER=hirearchy
STAGING_PROOF_AUDIENCE=database
STAGING_PROOF_KEY_ID=staging-key-1
# Base64-encoded PKCS#8 DER private key:
STAGING_PROOF_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key

# Symmetric Candidate Token Encryption Key (AES-256-GCM)
# 32 random bytes, base64-encoded:
HIREARCHY_CANDIDATE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-aes-key

# Operational Capability Restrictions (Truthful by Default)
HIREARCHY_SELF_SERVICE_ONBOARDING_ENABLED=true
HIREARCHY_RATE_LIMIT_ENABLED=true
HIREARCHY_AUTH_RATE_LIMIT_MAX=20
HIREARCHY_AUTH_RATE_LIMIT_WINDOW_MS=60000
HIREARCHY_STAGING_RATE_LIMIT_MAX=100
HIREARCHY_STAGING_RATE_LIMIT_WINDOW_MS=60000
HIREARCHY_CANDIDATE_RATE_LIMIT_MAX=60
HIREARCHY_CANDIDATE_RATE_LIMIT_WINDOW_MS=60000

# Operational Logging
HIREARCHY_LOG_VERBOSE=false
