{
  "name": "hirearchy-software",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen apps/web && tsc --project apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "next build apps/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "next": "16.3.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
